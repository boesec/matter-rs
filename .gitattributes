# Text files are stored and checked out with LF line endings: the main targets are Linux, and
# the formatter writes LF on every platform.
* text=auto eol=lf

# Windows-only scripts keep CRLF so that older PowerShell hosts read them without surprises.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.der binary
*.zip binary
*.gz binary
