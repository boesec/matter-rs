# PICS of the engine example onoff_node (crates/engine-rsmatter/examples/onoff_node.rs), in the
# key=value form the connectedhomeip Python test framework reads. Hand-written: the root
# endpoint is what rs-matter serves for an Ethernet node, the bridged endpoint 2 is the
# example's initial on/off light.

# Descriptor (every endpoint)
DESC.S=1
DESC.S.A0000=1
DESC.S.A0001=1
DESC.S.A0002=1
DESC.S.A0003=1

# Basic Information (root endpoint): rs-matter's full cluster without Reachable
BINFO.S=1
BINFO.S.A0000=1
BINFO.S.A0001=1
BINFO.S.A0002=1
BINFO.S.A0003=1
BINFO.S.A0004=1
BINFO.S.A0005=1
BINFO.S.A0006=1
BINFO.S.A0007=1
BINFO.S.A0008=1
BINFO.S.A0009=1
BINFO.S.A000a=1
BINFO.S.A000b=1
BINFO.S.A000c=1
BINFO.S.A000d=1
BINFO.S.A000e=1
BINFO.S.A000f=1
BINFO.S.A0010=1
BINFO.S.A0012=1
BINFO.S.A0013=1
BINFO.S.A0014=1
BINFO.S.A0015=1
BINFO.S.A0016=1
BINFO.S.A0018=1

# General Commissioning
CGEN.S=1
CGEN.S.A0000=1
CGEN.S.A0001=1
CGEN.S.A0002=1
CGEN.S.A0003=1
CGEN.S.A0004=1
CGEN.S.C00.Rsp=1
CGEN.S.C02.Rsp=1
CGEN.S.C04.Rsp=1

# Administrator Commissioning
CADMIN.S=1
CADMIN.S.A0000=1
CADMIN.S.A0001=1
CADMIN.S.A0002=1
CADMIN.S.C00.Rsp=1
CADMIN.S.C02.Rsp=1

# Bridged Device Basic Information on the bridged endpoint: NodeLabel, Reachable, UniqueID
BRBINFO.S=1
BRBINFO.S.A0005=1
BRBINFO.S.A0011=1
BRBINFO.S.A0012=1
BRBINFO.S.E03=1

# On/Off on the bridged endpoint
OO.S=1
OO.S.A0000=1
OO.S.C00.Rsp=1
OO.S.C01.Rsp=1
OO.S.C02.Rsp=1
